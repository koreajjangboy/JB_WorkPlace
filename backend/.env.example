# 이 파일을 .env 로 복사해서 쓴다. .env 는 git에 올리지 않는다.
# 비밀번호는 scripts/setup_db.ps1 이 만든 jb_workplace 계정의 것이다.
DATABASE_URL=postgresql+psycopg://jb_workplace:CHANGE_ME@localhost:5432/jb_workplace

# 이 폴더들의 바로 아래에 있는 git 저장소를 프로젝트로 등록한다. 쉼표로 여러 개 지정.
SCAN_ROOTS=C:\dev

# Claude Code 세션 기록 폴더 (기본값: 사용자 폴더\.claude\projects)
# CLAUDE_PROJECTS_DIR=C:\Users\<사용자>\.claude\projects

FRONTEND_ORIGIN=http://localhost:5173
