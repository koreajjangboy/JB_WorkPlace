# 이 파일을 .env 로 복사해서 쓴다. .env 는 git에 올리지 않는다.
# 비밀번호는 scripts/setup_db.ps1 이 만든 jb_workplace 계정의 것이다.
DATABASE_URL=postgresql+psycopg://jb_workplace:CHANGE_ME@localhost:5432/jb_workplace

# 이 폴더들의 바로 아래에 있는 git 저장소를 프로젝트로 등록한다. 쉼표로 여러 개 지정.
SCAN_ROOTS=C:\dev

# Claude Code 세션 기록 폴더 (기본값: 사용자 폴더\.claude\projects)
# CLAUDE_PROJECTS_DIR=C:\Users\<사용자>\.claude\projects

FRONTEND_ORIGIN=http://localhost:5173

# Google 캘린더: 캘린더 설정 > 캘린더 통합 > "iCal 형식의 비공개 주소". 쉼표로 여러 개 지정.
# 이 주소를 아는 사람은 누구나 일정을 볼 수 있으니 비밀번호처럼 다룬다.
# GOOGLE_CALENDAR_ICS_URLS=https://calendar.google.com/calendar/ical/.../private-.../basic.ics
# CALENDAR_TIMEZONE=Asia/Seoul

# Google Cloud 결제 내보내기(BigQuery) 테이블. 쉼표로 여러 개. 인증: gcloud auth application-default login
# GCP_BILLING_TABLES=프로젝트ID.billing_export.gcp_billing_export_v1_XXXXXX_XXXXXX_XXXXXX
# GCP_BILLING_SERVICES=Gemini API=gemini
